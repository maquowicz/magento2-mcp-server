# Magento 2 MCP Server Environment Variables
# Copy this file to .env in the project root (where your MCP client runs) and set your values.
# To use a named profile, copy it to .env.<profile> (e.g. .env.test) and set
# M2_API_MCP_ENV_PROFILE=<profile> in your MCP client's env/environment block.

M2_API_MCP_MAGENTO_URL=https://your-magento-store.com
M2_API_MCP_ADMIN_USERNAME=admin@example.com
M2_API_MCP_ADMIN_PASSWORD=your_password
# Log verbosity: debug | info (default) | warn | error
M2_API_MCP_LOG_LEVEL=info
